{
  "name": "hired-hand-resume-builder",
  "displayName": "Hired Hand: Resume Builder",
  "description": "Create an ATS-compatible resume from within VS Code by filling out a structured template section by section.",
  "version": "0.2.0",
  "publisher": "richardmcquiston01",
  "license": "Apache-2.0",
  "icon": "resources/icon.jpg",
  "repository": {
    "type": "git",
    "url": "https://github.com/RichardMcQuiston01/resume-ats-vscode-ext.git"
  },
  "keywords": [
    "resume",
    "cv",
    "ats",
    "job search",
    "career"
  ],
  "galleryBanner": {
    "color": "#2563EB",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:hiredHand.createResume",
    "onCommand:hiredHand.editResume",
    "onCommand:hiredHand.exportResume",
    "workspaceContains:**/resume.json"
  ],
  "contributes": {
    "commands": [
      {
        "command": "hiredHand.createResume",
        "title": "Hired Hand: Create New Resume",
        "icon": "$(new-file)"
      },
      {
        "command": "hiredHand.editResume",
        "title": "Hired Hand: Edit Resume",
        "icon": "$(edit)"
      },
      {
        "command": "hiredHand.exportResume",
        "title": "Hired Hand: Export Resume",
        "icon": "$(export)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "hiredHand.editResume",
          "when": "resourceFilename == resume.json",
          "group": "navigation@1"
        },
        {
          "command": "hiredHand.exportResume",
          "when": "resourceFilename == resume.json",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Hired Hand: Resume Builder",
      "properties": {
        "hiredHand.export.preset": {
          "type": "string",
          "enum": [
            "classic",
            "compact",
            "standard",
            "comfortable"
          ],
          "enumDescriptions": [
            "This extension's own look: Arial/Helvetica, 10 pt text, section headings in title case.",
            "Tighter spacing, so more fits on a page.",
            "The shared exporter's built-in look.",
            "Roomier spacing and larger text, easier to skim."
          ],
          "default": "classic",
          "markdownDescription": "Overall look of the HTML, Word, and PDF exports. The options below override individual parts of it. Markdown exports are unaffected. Every choice stays ATS-friendly: a single column of real text with real headings."
        },
        "hiredHand.export.fontFamily": {
          "type": "string",
          "enum": [
            "",
            "sans-serif",
            "serif",
            "monospace"
          ],
          "enumDescriptions": [
            "Use the preset's font.",
            "Arial / Helvetica.",
            "Times New Roman / Times.",
            "Courier New / Courier."
          ],
          "default": "",
          "markdownDescription": "Font family for HTML, Word, and PDF exports. Only these three standard families are offered because every ATS, PDF reader, and Word install has them."
        },
        "hiredHand.export.fontSize": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "minimum": 8,
          "maximum": 16,
          "markdownDescription": "Body text size in points (8 to 16). Leave empty to use the preset. 10 to 12 is the usual range for a resume."
        },
        "hiredHand.export.nameFontSize": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "minimum": 12,
          "maximum": 36,
          "markdownDescription": "Size of your name at the top, in points (12 to 36). Leave empty to use the preset."
        },
        "hiredHand.export.headingFontSize": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "minimum": 8,
          "maximum": 18,
          "markdownDescription": "Size of section headings, in points (8 to 18). Leave empty to use the preset."
        },
        "hiredHand.export.lineSpacing": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "minimum": 1,
          "maximum": 2,
          "markdownDescription": "Line height as a multiple of the font size (1 to 2). About 1.15 to 1.4 reads comfortably. Leave empty to use the preset."
        },
        "hiredHand.export.sectionSpacing": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "minimum": 0,
          "maximum": 36,
          "markdownDescription": "Space above each section heading, in points (0 to 36). Leave empty to use the preset."
        },
        "hiredHand.export.entrySpacing": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "minimum": 0,
          "maximum": 24,
          "markdownDescription": "Space between entries within a section, in points (0 to 24). Leave empty to use the preset."
        },
        "hiredHand.export.margin": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "minimum": 18,
          "maximum": 108,
          "markdownDescription": "Page margin on all four sides, in points (18 to 108; 72 = 1 inch). Leave empty to use the preset."
        },
        "hiredHand.export.pageSize": {
          "type": "string",
          "enum": [
            "",
            "letter",
            "a4"
          ],
          "enumDescriptions": [
            "Use the preset's paper size.",
            "US Letter.",
            "A4."
          ],
          "default": "",
          "markdownDescription": "Paper size for PDF and Word exports."
        },
        "hiredHand.export.headingCase": {
          "type": "string",
          "enum": [
            "",
            "upper",
            "title"
          ],
          "enumDescriptions": [
            "Use the preset's heading style.",
            "SECTION HEADINGS IN CAPITALS.",
            "Section headings as written (Experience)."
          ],
          "default": "",
          "markdownDescription": "How section headings are written."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc -p ./ --noEmit",
    "compile-tests": "tsc -p ./",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "pretest": "npm run compile-tests && npm run build",
    "test:unit": "mocha --ui tdd \"out/test/unit/**/*.test.js\"",
    "test:integration": "vscode-test",
    "test": "npm run test:unit && npm run test:integration",
    "package": "vsce package"
  },
  "dependencies": {
    "@richardmcquiston01/ats-resume-export": "^0.3.0",
    "docx": "^9.0.2",
    "jsonc-parser": "^3.3.1",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.7",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^2.4.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jszip": "3.10.2",
    "mocha": "^12.0.2",
    "prettier": "^3.3.2",
    "typescript": "^5.4.5"
  }
}
